PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/multi_agent_chatbot
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
OTP_SECRET=replace-with-another-long-random-secret
OTP_RESEND_COOLDOWN_SECONDS=60
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-app-password
EMAIL_FROM="Forma <your-email@example.com>"
# Legacy sender variable; EMAIL_FROM takes precedence.
MAIL_FROM="Forma <your-email@example.com>"
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
LLM_TIMEOUT_MS=60000
EMBEDDING_MODEL=nomic-embed-text:latest
RAG_MIN_SIMILARITY=0.22
